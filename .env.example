# AgentFlow AI Environment Variables
# See DEPLOYMENT.md for complete configuration guide

# Application
PROJECT_NAME=AgentFlow AI
SECRET_KEY=your-secret-key-change-this-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=604800

# Database
DATABASE_URL=sqlite:///./agentflow.db

# FreeLLMAPI Configuration (Optional - for agent workflows)
# FREELLMAPI_BASE_URL=https://your-freellmapi-endpoint.com
# FREELLMAPI_API_KEY=your-openai-api-key-here
# FREELLMAPI_MODEL=gpt-3.5-turbo
# FREELLMAPI_TEMPERATURE=0.7
# FREELLMAPI_MAX_TOKENS=1000

# Redis (for background tasks - optional)
# REDIS_URL=redis://localhost:6379/0

# CORS Configuration
# CORS_ORIGINS=http://localhost:3001,http://localhost:8000
